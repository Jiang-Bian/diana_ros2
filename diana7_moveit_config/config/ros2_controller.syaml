controller_manager:
  ros__parameters:
    update_rate: 1000

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

    diana_arm_controller:
      type: joint_trajectory_controller/JointTrajectoryController

joint_state_broadcaster:
  ros__parameter:
    use_local_topics: false

diana_arm_controller:
  ros__parameters:
    joints:
      - joint1
      - joint2
      - joint3
      - joint4
      - joint5
      - joint6
      - joint7

    command_interfaces:
      - position

    state_interfaces:
      - position
      - velocity

    state_publish_rate: 100.0

    action_monitor_rate: 20.0

    allow_partial_joints_goal: false

    open_loop_control: true

    allow_integration_in_goal_trajectories: false

    interpolate_from_desired_state: false

    constraints:
      stopped_velocity_tolerance: 0.02

      goal_time: 0.0

      joint1:
        trajectory: 0.05
        goal: 0.01

      joint2:
        trajectory: 0.05
        goal: 0.01

      joint3:
        trajectory: 0.05
        goal: 0.01

      joint4:
        trajectory: 0.05
        goal: 0.01

      joint5:
        trajectory: 0.05
        goal: 0.01

      joint6:
        trajectory: 0.05
        goal: 0.01

      joint7:
        trajectory: 0.05
        goal: 0.01
